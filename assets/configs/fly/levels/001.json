  "script": "\n---level1 script---\n\nlocal isPlayingDemo = false\nlocal countFail = 0\nlocal isSkip = true\nlocal hasViewedStory = global.getBool(\"lvl1_b1\")\n\nif not hasViewedStory or not game.isRestart() then\n\trepeat\n\t\tif hasViewedStory then dialog.setSkipEnabled(true) end\n\t\tgame.setUserInputEnabled(false)\n\t\trole.setIdleActionEnabled(false)\n\t\t\n\t\tgame.pauseLogic()\n\t\tif dialog.show(\"Level1-1\", faceRenzhen) ==1 then break end\n\t\tgame.resumeLogic()\n\t\t\n\t\tscript.delay(1)\n\t\tif dialog.show(\"~~~~~~\", facePutong) ==1 then break end\n\t\trole.lookLeftRight()\n\t\tscript.delay(3)\n\t\tif dialog.show(\"Level1-2\", faceManyi) ==1 then break end\n\t\tsound.play(\"43-1\")\n\t\tif dialog.show(\"Level1-3\", faceBujie) ==1 then break end\n\t\tif dialog.show(\"Level1-4\", facePutong) ==1 then break end\n\t\tif dialog.show(\"Level1-5\", faceZhoumei) ==1 then break end\n\t\tsound.play(\"50-1\")\n\t\tcamera.setFollowRoleMode(false)\n\t\tcamera.gotoPosition(475,1050)\n\t\tif dialog.show(\"Level1-6\", faceManyi) ==1 then break end\n\t\tcamera.gotoRole()\n\t\tcamera.setFollowRoleMode(true)\n\t\tgame.showTutorialDiagram(1)\n\t\tif dialog.showMinTime(\"Level1-7\", faceWeixiao,4) ==1 then break end\n\t\tgame.showTutorialDiagram(0)\n\t\t\n\t\t---start playing demo\n\t\tdialog.setSkipEnabled(false)\n\t\tisPlayingDemo = true\n\t\tisSkip = false\n\t\t\n\t\tgame.setReplayMode()\n\t\tgame.loadTutorialRep(\"Rep_rd_1\")\n\t\treplay.skipNonControlFrames()\n\t\tdialog.showFixedTime(\"Level1-8\", faceRenzhen, 2)\n\t\tscript.delay(0.5)\n\t\tdialog.showFixedTime(\"Level1-9\", faceShijin, 2.8)\n\tuntil true\nend\n\nif isSkip then\n\tcamera.gotoRole()\n\tcamera.setFollowRoleMode(true)\n\tdialog.setSkipEnabled(false)\n\tgame.resumeLogic()\n\tgame.showTutorialDiagram(0)\n\tgame.setUserInputEnabled(true)\n\trole.setIdleActionEnabled(true)\n\tgame.restartTiming()\nend\n\nonRoleReachedMoon = function() \n    if isPlayingDemo then\n        replay.pause()\n\t\tgame.setPlayMode()\n\t\tgame.setUserInputEnabled(false)\n        role.loadState()\n        script.delay(1.2)\n        dialog.show(\"Level1-10\", faceDeyi)\n        game.setUserInputEnabled(true)\n        game.restartTiming()\n\t\trole.setIdleActionEnabled(true)\n        isPlayingDemo = false\n        countFail = 0\n        --set story viewed flag\n        global.setBool(\"lvl1_b1\")\n    else\n        game.pauseLogic()\n\t\tsound.play(\"54-1\")\n        dialog.show(\"Level1-11\", faceManyi)\n        game.success()\n    end\nend\n\nonRoleDied = function()\n    countFail = countFail + 1\n    game.setUserInputEnabled(false)\n    if countFail <= 1 then\n\t\tsound.play(\"51-2\")\n        dialog.show(\"Level1-12\", faceBujie)\n    else\n\t\tsound.play(\"58-1\")\n        dialog.show(\"Level1-13\", faceShengqi)\n    end\n    game.setUserInputEnabled(true)\n    role.loadState()\nend"
}